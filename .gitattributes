# Images are binary
*.png  binary

# SQL, Python, docs and dashboard source use LF line endings
*.sql  text eol=lf
*.py   text eol=lf
*.md   text eol=lf
*.html text eol=lf
*.js   text eol=lf
*.svg  text eol=lf

# Query exports in results/ keep the line endings they were saved with
*.csv  -text

# Language bar: show the project as SQL; the dashboard (incl. generated index.html) is a presentation layer
*.sql linguist-language=SQL
dashboard/** linguist-detectable=false
